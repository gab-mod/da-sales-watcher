# Copy this file to .env and fill it in. Never commit .env: the cookie is your DeviantArt login.
# Wrap values in SINGLE quotes so Docker doesn't mess with special characters.

# --- DeviantArt (see README step 2) ---
DA_URL='https://www.deviantart.com/studio/earnings'
DA_COOKIE='PASTE-THE-WHOLE-COOKIE-HEADER-HERE'
DA_USER_AGENT='PASTE-YOUR-BROWSER-USER-AGENT-HERE'

# Regex that captures the earnings number(s); every group in parentheses is added up.
# Default: available balance + pending, as the earnings page shows them. Adjust after running the test.
# VALUE_REGEX='ableBalance\W+([\d.,]+)\W+pendingTransactions\W+([\d.,]+)'

# How often to check, in seconds (minimum 60). 300 = every 5 minutes.
INTERVAL_SECONDS=300
CURRENCY_SYMBOL='$'
# LOGIN_REMIND_HOURS=6

# --- Notifications: fill in ntfy, Telegram, or both ---

# ntfy: pick a long random topic name, nobody else should guess it
NTFY_URL='https://ntfy.sh/da-sales-CHANGE-THIS-xxxxxxxx'
# NTFY_TOKEN=''   # only if you self-host ntfy with access control

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=''
# TELEGRAM_CHAT_ID=''
